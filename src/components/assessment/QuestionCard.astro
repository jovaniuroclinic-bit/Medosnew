---
interface Option { label: string; value: number; }
interface Props { index: number; question: string; options: Option[]; name?: string; }
const { index, question, options, name = `q${index}` } = Astro.props;
---
<fieldset class="question-card" data-question-step hidden>
  <legend><span>Pregunta {index + 1}</span>{question}</legend>
  <div class="answer-list">
    {options.map((option) => (
      <label>
        <input type="radio" name={name} value={option.value} required />
        <span>{option.label}</span>
      </label>
    ))}
  </div>
</fieldset>

<style>
  .question-card { min-width: 0; margin: 0; padding: 0; border: 0; }
  .question-card[hidden] { display: none; }
  .question-card legend { width: 100%; margin-bottom: 1.25rem; color: var(--navy-deep); font-size: clamp(1.25rem, 3vw, 1.7rem); font-weight: 850; line-height: 1.3; }
  .question-card legend span { display: block; margin-bottom: 0.35rem; color: var(--blue); font-size: 0.76rem; letter-spacing: 0.08em; text-transform: uppercase; }
  .answer-list { display: grid; gap: 0.65rem; }
  .answer-list label { display: grid; min-height: 52px; grid-template-columns: auto 1fr; align-items: center; gap: 0.8rem; padding: 0.75rem 0.9rem; border: 1px solid var(--line-strong); border-radius: 0.85rem; cursor: pointer; }
  .answer-list label:has(input:checked) { border-color: var(--blue); background: #edf8fc; box-shadow: 0 0 0 2px rgba(8, 121, 181, 0.12); }
  .answer-list input { width: 1.2rem; height: 1.2rem; accent-color: var(--blue); }
</style>
