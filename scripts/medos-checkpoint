#!/usr/bin/env bash
set -euo pipefail
root="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 2
cd "$root"
message=""; do_commit=0; do_push=0; wait_ci=0
while [[ $# -gt 0 ]]; do case "$1" in --message) message="${2:-}"; shift 2;; --message=*) message="${1#*=}"; shift;; --commit) do_commit=1; shift;; --push) do_push=1; shift;; --wait-ci) wait_ci=1; shift;; *) exit 2;; esac; done
[[ "$do_push" -eq 0 || "$do_commit" -eq 1 ]] || { echo "--push requiere --commit" >&2; exit 2; }
if [[ "$do_commit" -eq 0 ]]; then echo "Checkpoint revisado; no se creó commit."; exit 0; fi
[[ -n "${message// }" ]] || { echo "Mensaje requerido para commit" >&2; exit 2; }
git diff --check
git add -- scripts/centinela scripts/medos-* scripts/install-termux-launcher sentinel-offline/src/centinela.ts sentinel-offline/src/cliRedaction.ts sentinel-offline/test/centinela.test.mjs sentinel-offline/cli docs/continuity package.json .gitignore .env.example 2>/dev/null || true
git commit -m "$message"
if [[ "$do_push" -eq 1 ]]; then git push origin HEAD; fi
if [[ "$wait_ci" -eq 1 ]]; then command -v gh >/dev/null || exit 6; gh run watch --exit-status; fi
