# Name: MEDOS_LAUNCHER_PORT; Purpose: port; Required: no; Secret: no; Vault: no; Origin: operator; Format: integer; Consumer: Launcher/CLI
MEDOS_LAUNCHER_PORT=<PUERTO_LOCAL_CONFIGURADO>
# Name: MEDOS_N8N_PORT; Purpose: port; Required: no; Secret: no; Vault: no; Origin: operator; Format: integer; Consumer: n8n/CLI
MEDOS_N8N_PORT=5678
