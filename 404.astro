---
import Base from "../layouts/Base.astro";
---

<Base
  title="Página no encontrada | UROCLINIC Dr. Jovani"
  description="La dirección solicitada no existe. Regresa al inicio de UROCLINIC o solicita una valoración."
>
  <section class="page-hero">
    <div class="container narrow-copy">
      <span class="eyebrow">Error 404</span>
      <h1>Esta página no está disponible</h1>
      <p class="kicker">La dirección pudo cambiar o estar incompleta.</p>
      <div class="button-row">
        <a class="button button--primary" href="/">Volver al inicio</a>
        <a class="button button--secondary" href="/contacto#solicitud">Solicitar valoración</a>
      </div>
    </div>
  </section>
</Base>
