{
  "name": "medos-web",
  "version": "0.0.1",
  "description": "MEDOS public web presence - UROCLINIC DR. JOVANI",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@11.18.0",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "typecheck": "astro check && tsc -p sentinel-offline/tsconfig.json --noEmit",
    "lint": "biome lint src public sentinel-offline/src sentinel-offline/config sentinel-offline/package.json sentinel-offline/tsconfig.json package.json astro.config.mjs tsconfig.json wrangler.jsonc verify-build.mjs",
    "format": "biome format --write src public package.json astro.config.mjs tsconfig.json wrangler.jsonc verify-build.mjs",
    "test": "tsc -p sentinel-offline/tsconfig.json && tsc -p sentinel-offline/launcher/tsconfig.json && node --test",
    "verify": "node verify-build.mjs",
    "verify:build": "pnpm verify",
    "check": "astro check",
    "deploy:dry-run": "wrangler deploy --dry-run",
    "deploy": "wrangler deploy",
    "sentinel:build": "tsc -p sentinel-offline/tsconfig.json",
    "sentinel:verify": "node sentinel-offline/build/cli.js verificar-instalacion",
    "sentinel:start": "tsc -p sentinel-offline/tsconfig.json && node sentinel-offline/build/localServer.js",
    "sentinel:ui": "tsc -p sentinel-offline/tsconfig.json && node sentinel-offline/build/localServer.js",
    "launcher:scan-secrets": "node sentinel-offline/launcher/scripts/verify-no-secrets.mjs"
  },
  "dependencies": {
    "astro": "^7.1.6"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@biomejs/biome": "^2.5.4",
    "@cloudflare/workers-types": "5.20260729.1",
    "@types/node": "22.20.1",
    "typescript": "^5.9.3",
    "wrangler": "4.115.0"
  },
  "engines": {
    "node": ">=22.0.0 <23",
    "pnpm": ">=11.18.0 <12"
  }
}
