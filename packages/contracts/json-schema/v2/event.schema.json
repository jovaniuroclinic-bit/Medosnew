{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.medos.local/v2/event.schema.json",
  "title": "MEDOS Event V2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "chain_id",
    "sequence_number",
    "occurred_at",
    "observed_at",
    "tenant_id",
    "device_id",
    "correlation_id",
    "causation_id",
    "classification",
    "retention_class",
    "cryptography",
    "event_type",
    "actor",
    "payload"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0.0"
    },
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "chain_id": {
      "type": "string",
      "format": "uuid"
    },
    "sequence_number": {
      "type": "integer",
      "minimum": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "tenant_id": {
      "type": "string",
      "format": "uuid"
    },
    "device_id": {
      "type": "string",
      "format": "uuid"
    },
    "correlation_id": {
      "type": "string",
      "format": "uuid"
    },
    "causation_id": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "classification": {
      "enum": [
        "PUBLIC",
        "INTERNAL",
        "CONFIDENTIAL",
        "RESTRICTED"
      ]
    },
    "retention_class": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{1,63}$"
    },
    "cryptography": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hash_algorithm",
        "previous_hash",
        "current_hash",
        "signature_algorithm",
        "signing_key_id",
        "signature"
      ],
      "properties": {
        "hash_algorithm": {
          "const": "SHA-256"
        },
        "previous_hash": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-fA-F]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "current_hash": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{64}$"
        },
        "signature_algorithm": {
          "const": "Ed25519"
        },
        "signing_key_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:-]{1,128}$"
        },
        "signature": {
          "type": "string",
          "pattern": "^[A-Za-z0-9+/]*={0,2}$",
          "maxLength": 4096
        }
      }
    },
    "event_type": {
      "enum": [
        "AUDIT_CHECKPOINT_CREATED",
        "CONSENT_GRANTED",
        "CONSENT_REVOKED"
      ]
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actor_id",
        "actor_type"
      ],
      "properties": {
        "actor_id": {
          "type": "string",
          "format": "uuid"
        },
        "actor_type": {
          "enum": [
            "HUMAN",
            "SERVICE",
            "DEVICE",
            "SYSTEM"
          ]
        }
      }
    },
    "payload": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "consent_id",
            "categories"
          ],
          "properties": {
            "kind": {
              "const": "CONSENT_GRANTED"
            },
            "consent_id": {
              "type": "string",
              "format": "uuid"
            },
            "categories": {
              "type": "array",
              "minItems": 1,
              "maxItems": 32,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "maxLength": 64
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "consent_id",
            "effective_at"
          ],
          "properties": {
            "kind": {
              "const": "CONSENT_REVOKED"
            },
            "consent_id": {
              "type": "string",
              "format": "uuid"
            },
            "effective_at": {
              "type": "string",
              "format": "date-time"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "checkpoint_hash"
          ],
          "properties": {
            "kind": {
              "const": "AUDIT_CHECKPOINT_CREATED"
            },
            "checkpoint_hash": {
              "type": "string",
              "pattern": "^[0-9a-fA-F]{64}$"
            }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "CONSENT_GRANTED"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "consent_id",
              "categories"
            ],
            "properties": {
              "kind": {
                "const": "CONSENT_GRANTED"
              },
              "consent_id": {
                "type": "string",
                "format": "uuid"
              },
              "categories": {
                "type": "array",
                "minItems": 1,
                "maxItems": 32,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "maxLength": 64
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "CONSENT_REVOKED"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "consent_id",
              "effective_at"
            ],
            "properties": {
              "kind": {
                "const": "CONSENT_REVOKED"
              },
              "consent_id": {
                "type": "string",
                "format": "uuid"
              },
              "effective_at": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "AUDIT_CHECKPOINT_CREATED"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "checkpoint_hash"
            ],
            "properties": {
              "kind": {
                "const": "AUDIT_CHECKPOINT_CREATED"
              },
              "checkpoint_hash": {
                "type": "string",
                "pattern": "^[0-9a-fA-F]{64}$"
              }
            }
          }
        }
      }
    }
  ]
}
