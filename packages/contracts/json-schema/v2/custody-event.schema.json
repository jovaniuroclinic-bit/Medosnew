{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.medos.local/v2/custody-event.schema.json",
  "title": "Custody Event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "chain_id",
    "sequence_number",
    "occurred_at",
    "observed_at",
    "tenant_id",
    "device_id",
    "correlation_id",
    "causation_id",
    "classification",
    "retention_class",
    "cryptography",
    "custody_event_id",
    "evidence_id",
    "state"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0.0"
    },
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "chain_id": {
      "type": "string",
      "format": "uuid"
    },
    "sequence_number": {
      "type": "integer",
      "minimum": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "tenant_id": {
      "type": "string",
      "format": "uuid"
    },
    "device_id": {
      "type": "string",
      "format": "uuid"
    },
    "correlation_id": {
      "type": "string",
      "format": "uuid"
    },
    "causation_id": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "classification": {
      "enum": [
        "PUBLIC",
        "INTERNAL",
        "CONFIDENTIAL",
        "RESTRICTED"
      ]
    },
    "retention_class": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{1,63}$"
    },
    "cryptography": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hash_algorithm",
        "previous_hash",
        "current_hash",
        "signature_algorithm",
        "signing_key_id",
        "signature"
      ],
      "properties": {
        "hash_algorithm": {
          "const": "SHA-256"
        },
        "previous_hash": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-fA-F]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "current_hash": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{64}$"
        },
        "signature_algorithm": {
          "const": "Ed25519"
        },
        "signing_key_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:-]{1,128}$"
        },
        "signature": {
          "type": "string",
          "pattern": "^[A-Za-z0-9+/]*={0,2}$",
          "maxLength": 4096
        }
      }
    },
    "state": {
      "enum": [
        "RECEIVED",
        "STORED",
        "ACCESSED",
        "EXPORTED",
        "TRANSFERRED",
        "DELETED"
      ]
    },
    "consent_id": {
      "type": "string",
      "format": "uuid"
    },
    "permit_id": {
      "type": "string",
      "format": "uuid"
    },
    "session_id": {
      "type": "string",
      "format": "uuid"
    },
    "segment_id": {
      "type": "string",
      "format": "uuid"
    },
    "evidence_id": {
      "type": "string",
      "format": "uuid"
    },
    "custody_event_id": {
      "type": "string",
      "format": "uuid"
    },
    "incident_id": {
      "type": "string",
      "format": "uuid"
    },
    "risk_id": {
      "type": "string",
      "format": "uuid"
    },
    "receipt_id": {
      "type": "string",
      "format": "uuid"
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "mandatory_stop_at": {
      "type": "string",
      "format": "date-time"
    },
    "deleted_at": {
      "type": "string",
      "format": "date-time"
    },
    "ciphertext_hash": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{64}$"
    },
    "object_hash": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{64}$"
    },
    "severity": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10
    },
    "score": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "formula_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    }
  }
}
