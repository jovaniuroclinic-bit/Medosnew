#!/data/data/com.termux/files/usr/bin/bash
set -Eeuo pipefail
umask 077
root="$(git rev-parse --show-toplevel)"
module="$root/sentinel-offline/launcher"
test -f "$module/package.json" || { echo "Repositorio incorrecto"; exit 1; }
case "${1:-}" in
 --doctor) node --version; test -x "$module/node_modules/.bin/tsc"; echo "Vault: configuración requerida"; exit;;
 --vault-doctor) echo "Backend seleccionado: ninguno"; echo "Persistencia: BLOQUEADA hasta selección por clic"; exit 2;;
 --select-vault) echo "Abra la UI local y seleccione explícitamente un backend."; set -- --no-browser;;
 --backup|--verify-backups|--restore-test|--recovery-kit) echo "BLOQUEADO: seleccione una bóveda y destino cifrado."; exit 2;;
 --recover-all) echo "Recuperación no secreta preparada; autorizaciones requieren clic."; set -- --no-browser;;
 --status) curl -fsS http://127.0.0.1:4319/api/health || true; exit;;
 --lock-all) echo "Abra la UI y reautentique para bloquear."; exit 2;;
esac
cd "$module"
exec node build/server/index.js
