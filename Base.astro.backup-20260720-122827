---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = "UROCLINIC Dr. Jovani - Urología Torreón",
  description = "Consultas de Urología en Torreón, Coahuila. Dr. E. Jovani Torres Guevara.",
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="canonical" content={canonicalURL} />
    <title>{title}</title>

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />

    <!-- JSON-LD -->
    <script is:inline type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "MedicalBusiness",
      "name": "UROCLINIC Dr. Jovani",
      "url": Astro.site?.toString(),
      "medicalSpecialty": "Urology",
      "areaServed": "Torreón, Coahuila, Mexico",
    })} />

    <!-- Robots & Preview -->
    <meta name="robots" content={import.meta.env.DEV ? "noindex, nofollow" : "index, follow"} />
  </head>
  <body>
    <nav aria-label="Navegación principal">
      <a href="/">Inicio</a>
      <a href="/servicios">Servicios</a>
      <a href="/privacidad">Privacidad</a>
      <a href="/contacto">Contacto</a>
    </nav>

    <main role="main">
      <slot />
    </main>

    <footer>
      <p>&copy; {new Date().getFullYear()} UROCLINIC Dr. Jovani. Todos los derechos reservados.</p>
      <p>Torreón, Coahuila, México</p>
    </footer>

    <style>
      body {
        font-family: system-ui, sans-serif;
        line-height: 1.5;
        color: #333;
        background: #fff;
      }
      nav {
        background: #f5f5f5;
        padding: 1rem;
        margin-bottom: 2rem;
      }
      nav a {
        margin-right: 1.5rem;
        text-decoration: none;
        color: #0066cc;
      }
      nav a:hover {
        text-decoration: underline;
      }
      main {
        max-width: 900px;
        margin: 0 auto;
        padding: 2rem 1rem;
      }
      footer {
        background: #f5f5f5;
        padding: 2rem 1rem;
        text-align: center;
        border-top: 1px solid #ddd;
        margin-top: 3rem;
      }
    </style>
  </body>
</html>
