---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "UROCLINIC Dr. Jovani | Urología en Torreón",
  description =
    "Atención urológica en Torreón con privacidad, orientación clara y revisión humana de cada solicitud.",
} = Astro.props;

const siteEnvironment = import.meta.env.PUBLIC_SITE_ENV ?? "preview";
const isProduction = siteEnvironment === "production";
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const socialImageURL = new URL("/social-card.png", Astro.site);
const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
const phoneHref = "tel:+528713302526";
const whatsappHref =
  "https://wa.me/528712657523?text=Hola%2C%20deseo%20consultar%20disponibilidad%20de%20cita.";
const address =
  "Ignacio Allende Oriente 139, Primero de Cobián Centro, CP 27000, Torreón, Coahuila";

const navigation = [
  { href: "/", label: "Inicio" },
  { href: "/servicios", label: "Servicios" },
  { href: "/programas", label: "Programas" },
  { href: "/contacto", label: "Contacto" },
];

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "MedicalClinic",
      "@id": `${Astro.site?.toString()}#clinic`,
      name: "UROCLINIC Dr. Jovani",
      url: Astro.site?.toString(),
      telephone: "+52 871 330 2526",
      medicalSpecialty: "Urology",
      address: {
        "@type": "PostalAddress",
        streetAddress: "Ignacio Allende Oriente 139, Primero de Cobián Centro",
        postalCode: "27000",
        addressLocality: "Torreón",
        addressRegion: "Coahuila",
        addressCountry: "MX",
      },
      hasOfferCatalog: {
        "@type": "OfferCatalog",
        name: "Servicios y rutas de atención urológica",
        itemListElement: [
          { "@type": "Offer", itemOffered: { "@type": "MedicalProcedure", name: "Consulta urológica" } },
          { "@type": "Offer", itemOffered: { "@type": "MedicalProcedure", name: "Valoración preventiva" } },
          { "@type": "Offer", itemOffered: { "@type": "MedicalProcedure", name: "Seguimiento urológico" } },
        ],
      },
    },
    {
      "@type": "Physician",
      "@id": `${Astro.site?.toString()}#physician`,
      name: "Dr. E. Jovani Torres Guevara",
      medicalSpecialty: "Urology",
      worksFor: { "@id": `${Astro.site?.toString()}#clinic` },
      sameAs: ["https://www.drjovaniurologo.com/"],
    },
  ],
};
---

<!doctype html>
<html lang="es-MX">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta
      name="robots"
      content={isProduction
        ? "index, follow, max-image-preview:large"
        : "noindex, nofollow, noarchive, nosnippet"}
    />
    <meta name="theme-color" content="#063f61" />
    <meta name="color-scheme" content="light" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="manifest" href="/site.webmanifest" />
    <title>{title}</title>

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_MX" />
    <meta property="og:site_name" content="UROCLINIC Dr. Jovani" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImageURL} />
    <meta property="og:image:alt" content="UROCLINIC Dr. Jovani, Urología en Torreón" />
    <meta name="twitter:card" content="summary_large_image" />

    <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>

    {!isProduction && (
      <div class="preview-banner" role="status">
        PREVIEW seguro · Usa únicamente datos sintéticos · No publicar todavía
      </div>
    )}

    <div class="contact-strip">
      <div class="container contact-strip-inner">
        <span>Atención urológica programada en Torreón, Coahuila</span>
        <div>
          <a href={phoneHref}>Llamadas: 871 330 2526</a>
          <a href={whatsappHref} rel="noopener noreferrer">WhatsApp: 871 265 7523</a>
        </div>
      </div>
    </div>

    <header class="site-header">
      <div class="container header-inner">
        <a class="brand" href="/" aria-label="UROCLINIC Dr. Jovani, inicio">
          <span class="brand-mark" aria-hidden="true">
            <svg viewBox="0 0 48 48" role="img">
              <path d="M11 8h8v19c0 6 2 9 5 9s5-3 5-9V8h8v20c0 11-5 17-13 17S11 39 11 28V8Z" fill="currentColor" />
            </svg>
          </span>
          <span class="brand-copy">
            <strong>UROCLINIC</strong>
            <small>Dr. Jovani · Urología</small>
          </span>
        </a>

        <nav aria-label="Navegación principal">
          <ul class="nav-list">
            {navigation.map((item) => {
              const itemPath = item.href.replace(/\/$/, "") || "/";
              return (
                <li>
                  <a href={item.href} aria-current={currentPath === itemPath ? "page" : undefined}>
                    {item.label}
                  </a>
                </li>
              );
            })}
          </ul>
        </nav>

        <a class="header-cta" href="/contacto#solicitud">Solicitar valoración</a>
      </div>
    </header>

    <main id="contenido">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container footer-grid">
        <section aria-labelledby="footer-brand">
          <a class="brand brand--footer" href="/">
            <span class="brand-mark" aria-hidden="true">
              <svg viewBox="0 0 48 48">
                <path d="M11 8h8v19c0 6 2 9 5 9s5-3 5-9V8h8v20c0 11-5 17-13 17S11 39 11 28V8Z" fill="currentColor" />
              </svg>
            </span>
            <span class="brand-copy">
              <strong id="footer-brand">UROCLINIC</strong>
              <small>Dr. Jovani · Urología</small>
            </span>
          </a>
          <p>Atención urológica con privacidad, comunicación clara y seguimiento humano.</p>
          <p class="credentials">Cédula profesional 7769599 · Cédula de especialidad 11068744</p>
        </section>

        <section aria-labelledby="footer-contact">
          <h2 id="footer-contact">Contacto</h2>
          <address>
            <a href={phoneHref}>871 330 2526</a><br />
            <a href={whatsappHref} rel="noopener noreferrer">WhatsApp 871 265 7523</a><br />
            {address}
          </address>
        </section>

        <section aria-labelledby="footer-links">
          <h2 id="footer-links">Explora</h2>
          <ul>
            <li><a href="/servicios">Servicios</a></li>
            <li><a href="/programas">Programas y membresías</a></li>
            <li><a href="/contacto">Solicitar valoración</a></li>
            <li><a href="/privacidad">Aviso de privacidad</a></li>
          </ul>
        </section>
      </div>

      <div class="container footer-bottom">
        <p>© {new Date().getFullYear()} UROCLINIC Dr. Jovani.</p>
        <p>La información del sitio no sustituye una consulta médica. No es un servicio de urgencias.</p>
      </div>
    </footer>

    <nav class="mobile-actions" aria-label="Acciones rápidas">
      <a href={phoneHref}>Llamar</a>
      <a href={whatsappHref} rel="noopener noreferrer">WhatsApp</a>
      <a href="/contacto#solicitud">Solicitar</a>
    </nav>

    <style>
      .skip-link {
        position: fixed;
        z-index: 1000;
        top: 0.5rem;
        left: 0.5rem;
        padding: 0.75rem 1rem;
        border-radius: 0.6rem;
        background: #fff;
        color: var(--navy);
        box-shadow: var(--shadow);
        transform: translateY(-150%);
      }

      .skip-link:focus {
        transform: translateY(0);
      }

      .preview-banner {
        padding: 0.42rem 1rem;
        background: #fff1c9;
        color: #6d4b00;
        font-size: 0.8rem;
        font-weight: 850;
        text-align: center;
      }

      .contact-strip {
        background: var(--navy-deep);
        color: rgba(255, 255, 255, 0.82);
        font-size: 0.77rem;
      }

      .contact-strip-inner {
        display: flex;
        min-height: 2.2rem;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
      }

      .contact-strip-inner div {
        display: flex;
        gap: 1.2rem;
      }

      .contact-strip a {
        color: #fff;
        font-weight: 750;
        text-decoration: none;
      }

      .site-header {
        position: sticky;
        z-index: 100;
        top: 0;
        border-bottom: 1px solid rgba(217, 229, 236, 0.88);
        background: rgba(255, 255, 255, 0.94);
        backdrop-filter: blur(18px);
      }

      .header-inner {
        display: grid;
        min-height: 5.25rem;
        grid-template-columns: auto 1fr auto;
        align-items: center;
        gap: 1.5rem;
      }

      .brand {
        display: inline-flex;
        align-items: center;
        gap: 0.78rem;
        color: var(--navy-deep);
        text-decoration: none;
      }

      .brand-mark {
        display: grid;
        width: 2.75rem;
        height: 2.75rem;
        place-items: center;
        border-radius: 0.95rem;
        background: linear-gradient(145deg, var(--navy), var(--blue-bright));
        color: #fff;
        box-shadow: 0 10px 24px rgba(8, 121, 181, 0.22);
      }

      .brand-mark svg {
        width: 1.55rem;
        height: 1.55rem;
      }

      .brand-copy strong,
      .brand-copy small {
        display: block;
      }

      .brand-copy strong {
        letter-spacing: 0.055em;
      }

      .brand-copy small {
        margin-top: 0.05rem;
        color: var(--ink-soft);
        font-size: 0.72rem;
      }

      .nav-list {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.2rem;
        margin: 0;
        padding: 0;
        list-style: none;
      }

      .nav-list a {
        display: inline-flex;
        min-height: 2.65rem;
        align-items: center;
        padding: 0.55rem 0.85rem;
        border-radius: 999px;
        color: var(--ink-soft);
        font-size: 0.9rem;
        font-weight: 750;
        text-decoration: none;
      }

      .nav-list a:hover,
      .nav-list a[aria-current="page"] {
        background: #edf5f9;
        color: var(--navy-deep);
      }

      .header-cta {
        display: inline-flex;
        min-height: 3rem;
        align-items: center;
        justify-content: center;
        padding: 0.75rem 1.15rem;
        border-radius: 999px;
        background: linear-gradient(135deg, var(--navy), var(--blue));
        color: #fff;
        font-size: 0.9rem;
        font-weight: 850;
        text-decoration: none;
        box-shadow: 0 12px 28px rgba(3, 63, 97, 0.22);
      }

      .header-cta:hover {
        color: #fff;
        transform: translateY(-1px);
      }

      .site-footer {
        padding: 4.5rem 0 1.5rem;
        background: #032f4b;
        color: rgba(255, 255, 255, 0.72);
      }

      .footer-grid {
        display: grid;
        grid-template-columns: 1.45fr 1fr 0.8fr;
        gap: clamp(2rem, 6vw, 5rem);
      }

      .brand--footer {
        margin-bottom: 1.2rem;
        color: #fff;
      }

      .brand--footer .brand-copy small {
        color: rgba(255, 255, 255, 0.65);
      }

      .site-footer h2 {
        margin-bottom: 1rem;
        color: #fff;
        font-size: 1rem;
        letter-spacing: 0;
      }

      .site-footer p,
      .site-footer address,
      .site-footer li {
        font-size: 0.9rem;
      }

      .site-footer address {
        font-style: normal;
      }

      .site-footer a {
        color: rgba(255, 255, 255, 0.9);
      }

      .site-footer ul {
        display: grid;
        gap: 0.55rem;
        margin: 0;
        padding: 0;
        list-style: none;
      }

      .credentials {
        color: rgba(255, 255, 255, 0.48);
        font-size: 0.75rem !important;
      }

      .footer-bottom {
        display: flex;
        justify-content: space-between;
        gap: 1rem;
        margin-top: 3rem;
        padding-top: 1.25rem;
        border-top: 1px solid rgba(255, 255, 255, 0.12);
      }

      .footer-bottom p {
        margin: 0;
        font-size: 0.76rem;
      }

      .mobile-actions {
        display: none;
      }

      @media (max-width: 62rem) {
        .header-inner {
          grid-template-columns: auto auto;
          justify-content: space-between;
        }

        .header-inner nav {
          grid-column: 1 / -1;
          grid-row: 2;
          overflow-x: auto;
          padding-bottom: 0.55rem;
        }

        .nav-list {
          justify-content: flex-start;
        }

        .footer-grid {
          grid-template-columns: 1fr 1fr;
        }

        .footer-grid section:first-child {
          grid-column: 1 / -1;
        }
      }

      @media (max-width: 48rem) {
        .contact-strip {
          display: none;
        }

        .header-inner {
          min-height: 4.6rem;
        }

        .header-cta {
          display: none;
        }

        .header-inner nav {
          display: none;
        }

        .site-header {
          top: 0;
        }

        .site-footer {
          padding-bottom: 5.8rem;
        }

        .footer-grid {
          grid-template-columns: 1fr;
        }

        .footer-grid section:first-child {
          grid-column: auto;
        }

        .footer-bottom {
          display: grid;
        }

        .mobile-actions {
          position: fixed;
          z-index: 200;
          right: 0.65rem;
          bottom: 0.65rem;
          left: 0.65rem;
          display: grid;
          grid-template-columns: 0.8fr 1fr 1.25fr;
          gap: 0.35rem;
          padding: 0.4rem;
          border: 1px solid rgba(255, 255, 255, 0.8);
          border-radius: 1.15rem;
          background: rgba(255, 255, 255, 0.94);
          box-shadow: 0 20px 60px rgba(3, 47, 75, 0.24);
          backdrop-filter: blur(16px);
        }

        .mobile-actions a {
          display: grid;
          min-height: 3rem;
          place-items: center;
          border-radius: 0.85rem;
          background: #eff5f8;
          color: var(--navy-deep);
          font-size: 0.78rem;
          font-weight: 850;
          text-decoration: none;
        }

        .mobile-actions a:last-child {
          background: linear-gradient(135deg, var(--navy), var(--blue));
          color: #fff;
        }
      }
    </style>
  </body>
</html>
